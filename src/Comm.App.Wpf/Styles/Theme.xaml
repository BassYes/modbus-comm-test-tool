<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Comm.App.Wpf.Converters">

    <!-- 报文颜色规范（见规划 4.6.2）：颜色之外同时有 TX/RX 文字与图标，不单靠颜色区分 -->
    <SolidColorBrush x:Key="TxBrush" Color="#1B5E9B" />
    <SolidColorBrush x:Key="RxBrush" Color="#1E7B34" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" />
    <SolidColorBrush x:Key="SystemBrush" Color="#616161" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E65100" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F7F7F9" />
    <SolidColorBrush x:Key="BorderBrushLight" Color="#D6D6DC" />

    <!-- R-21 X-4：字体回退链（小屏工控机 / 缺少雅黑或 Consolas 的环境） -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI, SimSun</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, Courier New</FontFamily>

    <conv:DirectionToBrushConverter x:Key="DirectionToBrush" />
    <conv:DirectionBrushToggleConverter x:Key="DirectionBrushToggle" />
    <conv:StatusToBrushConverter x:Key="StatusToBrush" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:LogStateToBrushConverter x:Key="LogStateToBrush" />

    <Style TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,10,0,6" />
        <Setter Property="Foreground" Value="#33333A" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#4A4A55" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="MinWidth" Value="76" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="Margin" Value="0,0,6,6" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="MinWidth" Value="110" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="0,0,12,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="HexBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Padding" Value="4,3" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#EDEDF2" />
        <Setter Property="RowHeight" Value="20" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="ClipboardCopyMode" Value="IncludeHeader" />
    </Style>
</ResourceDictionary>
