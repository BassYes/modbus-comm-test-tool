<UserControl x:Class="Comm.App.Wpf.Views.UnitIdScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <!-- 顶部：连接上下文 + 扫描参数 + 操作按钮（固定不滚动，B-01） -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="3"
                Background="{StaticResource PanelBrush}" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="TCP Unit ID 扫描（R-12，规划 4.2.7）" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="{Binding ConnectionContextText}" TextWrapping="Wrap" Foreground="#1B5E9B" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="起始 Unit ID" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding StartUnitId}" Width="80" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="结束 Unit ID" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding EndUnitId}" Width="80" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="响应超时 ms" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ResponseTimeoutMs}" Width="80" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="重试" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding RetryCount}" Width="50" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,10,0">
                        <TextBlock Text="间隔 ms" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding IntervalMs}" Width="60" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="5" Margin="0,0,10,0">
                        <TextBlock Text="确认次数" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ConfirmAttempts}" Width="50" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="6" Margin="0,0,10,0">
                        <TextBlock Text="并发度" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding ConcurrencyOptions}" DisplayMemberPath="Display"
                                  SelectedValuePath="Value" SelectedValue="{Binding Concurrency}" Width="120" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,10,0">
                        <CheckBox Content="尝试读取设备标识（43/14）" IsChecked="{Binding TryReadIdentification}" />
                        <CheckBox Content="手动探测模板（只允许只读功能码 01/02/03/04）" IsChecked="{Binding UseManualProbe}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,6,0,0"
                                IsEnabled="{Binding UseManualProbe}">
                        <TextBlock Text="功能码" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding ReadFunctionOptions}" DisplayMemberPath="Display"
                                  SelectedValuePath="Value" SelectedValue="{Binding ManualProbeFunction}" Width="150" />
                        <TextBlock Text="起始地址" VerticalAlignment="Center" Margin="10,0,6,0" />
                        <TextBox Text="{Binding ManualProbeAddress}" Width="80" />
                        <TextBlock Text="数量" VerticalAlignment="Center" Margin="10,0,6,0" />
                        <TextBox Text="{Binding ManualProbeQuantity}" Width="60" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="开始扫描" Command="{Binding StartScanCommand}" IsEnabled="{Binding CanStart}" FontWeight="SemiBold" />
                    <Button Content="暂停" Command="{Binding PauseScanCommand}" IsEnabled="{Binding IsScanning}" />
                    <Button Content="继续" Command="{Binding ResumeScanCommand}" IsEnabled="{Binding IsPaused}" />
                    <Button Content="停止" Command="{Binding StopScanCommand}" IsEnabled="{Binding IsScanning}" />
                    <Button Content="清空结果" Command="{Binding ClearResultsCommand}" />
                    <Button Content="导出 CSV" Command="{Binding ExportCsvCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding EstimatedText}" VerticalAlignment="Center" Foreground="#4A4A55" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>

                <ProgressBar Height="12" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" Foreground="#4A4A55" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#1B5E9B" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- 中部：结果表 -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Unit ID" Binding="{Binding UnitId}" Width="70" />
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="70" />
                <DataGridTextColumn Header="探测功能码" Binding="{Binding ProbeFunctionText}" Width="170" />
                <DataGridTextColumn Header="异常码" Binding="{Binding ExceptionText}" Width="180" />
                <DataGridTextColumn Header="首次发现" Binding="{Binding FirstSeen, StringFormat='{}{0:HH:mm:ss.fff}'}" Width="110" />
                <DataGridTextColumn Header="最近响应" Binding="{Binding LastSeen, StringFormat='{}{0:HH:mm:ss.fff}'}" Width="110" />
                <DataGridTextColumn Header="耗时 ms" Binding="{Binding ElapsedMs, StringFormat='{}{0:F1}'}" Width="80" />
                <DataGridTextColumn Header="确认" Binding="{Binding ConfirmText}" Width="60" />
                <DataGridTextColumn Header="设备标识" Binding="{Binding DeviceIdentification}" Width="200" />
                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部：详情 + 结果操作 + 扫描方案 -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="3"
                    Background="White" Padding="8" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="选中结果详情" Style="{StaticResource SectionHeader}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="设为默认 Unit ID" Command="{Binding UseSelectedUnitIdCommand}" />
                        <Button Content="保存为设备目标" Command="{Binding SaveAsTargetCommand}" />
                        <Button Content="复制详情" Command="{Binding CopySelectedRowCommand}" />
                    </StackPanel>
                    <TextBox Grid.Row="2" Text="{Binding DetailText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11"
                             VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" />
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="3"
                    Background="White" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="扫描方案" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="方案名称" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding PlanName}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="保存方案" Command="{Binding SavePlanCommand}" />
                            <Button Content="载入方案" Command="{Binding LoadPlanCommand}" />
                            <Button Content="删除方案" Command="{Binding DeletePlanCommand}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" Height="110" Margin="0,6,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock TextWrapping="Wrap" Foreground="#4A4A55" FontSize="11" Margin="0,6,0,0"
                                   Text="提示：Unit ID 扫描只发送只读探测请求（默认 03→04→01→02），绝不使用写功能码与广播地址 0；扫描期间会占用该 TCP 连接，请确认已获得对目标网关的授权。" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
