<UserControl x:Class="Comm.App.Wpf.Views.LanScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="3"
                Padding="12" Margin="0,0,12,0" Background="{StaticResource PanelBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="扫描范围" Style="{StaticResource SectionHeader}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="本机 IP（与掩码配合）" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding IpAddress}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="子网掩码 / 前缀" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaskText}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="或直接填写范围（优先于上面的 IP/掩码）" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding RangeText}" ToolTip="例如 192.168.1.0/24 或 192.168.1.10-192.168.1.50 或 192.168.1.10-50" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="用本机网卡" Command="{Binding UseLocalAdapterCommand}" />
                        <TextBlock Text="（网络工具页可先计算网段）" Foreground="#4A4A55" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="探测参数" Style="{StaticResource SectionHeader}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TCP 端口（可多个）" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding PortText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Unit ID（Modbus 识别）" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UnitId}" />
                        </StackPanel>
                    </Grid>

                    <CheckBox IsChecked="{Binding UseArp}" Content="ARP 探测（仅同一二层网段有效）" />
                    <CheckBox IsChecked="{Binding UseIcmp}" Content="ICMP（Ping）探测" />
                    <CheckBox IsChecked="{Binding IdentifyModbus}" Content="对开放端口做一次 Modbus 只读识别（默认关闭）" />
                    <CheckBox IsChecked="{Binding ResolveHostName}" Content="反查主机名（会增加每台设备耗时）" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="并发（16~256）" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Concurrency}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="单主机超时 ms" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding PerHostTimeoutMs}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="地址数量上限" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaxAddresses}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="下发间隔 ms（限速）" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SendDelayMs}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding RangeHint}" TextWrapping="Wrap" Foreground="#4A4A55" Margin="0,6,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="开始扫描" Command="{Binding StartCommand}" FontWeight="SemiBold"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                        <Button Content="暂停/继续" Command="{Binding PauseResumeCommand}" IsEnabled="{Binding IsRunning}" />
                        <Button Content="停止" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="清空" Command="{Binding ClearCommand}" />
                        <Button Content="导出 CSV" Command="{Binding ExportCommand}" />
                    </StackPanel>

                    <TextBlock Text="现场提示" Style="{StaticResource SectionHeader}" />
                    <TextBlock TextWrapping="Wrap" Foreground="#4A4A55"
                               Text="1. 请仅扫描已获授权的网段。&#10;2. 未确认 ≠ 离线：ICMP 无响应可能是防火墙或路由隔离。&#10;3. ARP 只在同一二层网段有效，跨网段拿不到 MAC。" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="3"
                    Padding="10" Margin="0,0,0,8" Background="White">
                <StackPanel>
                    <ProgressBar Height="14" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
                    <TextBlock Text="{Binding ProgressText}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#1B5E9B" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                <CheckBox IsChecked="{Binding OnlyResponsive}" Content="只显示有响应/未确认之外的主机" />
                <Button Content="主机详情" Command="{Binding ShowDetailCommand}" />
                <Button Content="设为 TCP 连接目标" Command="{Binding UseAsTcpTargetCommand}" />
            </StackPanel>

            <DataGrid Grid.Row="2" ItemsSource="{Binding ResultsView}" SelectedItem="{Binding SelectedHost}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Unconfirmed">
                                <Setter Property="Foreground" Value="#757575" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="130" />
                    <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="150" />
                    <DataGridTextColumn Header="主机名" Binding="{Binding HostName}" Width="160" />
                    <DataGridTextColumn Header="发现方式" Binding="{Binding KindText}" Width="90" />
                    <DataGridTextColumn Header="端口状态" Binding="{Binding PortText}" Width="90" />
                    <DataGridTextColumn Header="Modbus" Binding="{Binding ModbusText}" Width="110" />
                    <DataGridTextColumn Header="状态分级" Binding="{Binding StateText}" Width="110" />
                    <DataGridTextColumn Header="耗时 ms" Binding="{Binding LatencyText}" Width="80" />
                    <DataGridTextColumn Header="最近响应" Binding="{Binding LastSeen, StringFormat=HH:mm:ss.fff}" Width="110" />
                    <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
