<UserControl x:Class="Comm.App.Wpf.Views.RegisterLocatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 向导式参数 -->
        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="3"
                Padding="12" Margin="0,0,12,0" Background="{StaticResource PanelBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="1. 范围与目标" Style="{StaticResource SectionHeader}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="从站地址" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UnitId}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="数据区（仅寄存器区）" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding AreaOptions}" DisplayMemberPath="Display"
                                      SelectedValuePath="Value" SelectedValue="{Binding Area}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="起始地址" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding StartAddress}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="结束地址" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding EndAddress}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="定位模式" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding ModeOptions}" DisplayMemberPath="Display"
                              SelectedValuePath="Value" SelectedValue="{Binding Mode}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="目标值" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Target}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="容差 / 容差百分比" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Tolerance}" />
                        </StackPanel>
                    </Grid>
                    <TextBox Text="{Binding TolerancePercent}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="区间下限" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding TargetMin}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="区间上限" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding TargetMax}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="文本片段（文本模式，可空=任意）" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding TextPattern}" />

                    <TextBlock Text="2. 候选解释组合" Style="{StaticResource SectionHeader}" />
                    <WrapPanel>
                        <CheckBox IsChecked="{Binding TypeUInt16}" Content="UInt16" />
                        <CheckBox IsChecked="{Binding TypeInt16}" Content="Int16" />
                        <CheckBox IsChecked="{Binding TypeUInt32}" Content="UInt32" />
                        <CheckBox IsChecked="{Binding TypeInt32}" Content="Int32" />
                        <CheckBox IsChecked="{Binding TypeFloat32}" Content="Float32" />
                        <CheckBox IsChecked="{Binding TypeUInt64}" Content="UInt64" />
                        <CheckBox IsChecked="{Binding TypeInt64}" Content="Int64" />
                        <CheckBox IsChecked="{Binding TypeFloat64}" Content="Float64" />
                    </WrapPanel>

                    <CheckBox IsChecked="{Binding AllByteOrders}" Content="尝试全部四种字节序（ABCD/BADC/CDAB/DCBA）" />
                    <ComboBox ItemsSource="{Binding OrderOptions}" DisplayMemberPath="Display"
                              SelectedValuePath="Value" SelectedValue="{Binding CandidateOrder}"
                              IsEnabled="{Binding AllByteOrders, Converter={StaticResource InverseBool}}" />

                    <TextBlock Text="缩放系数（逗号分隔，如 1, 0.1, 0.01, 10）" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ScalesText}" />

                    <TextBlock Text="3. 采样与读取" Style="{StaticResource SectionHeader}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="采样轮数" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SampleCount}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="轮间隔 ms" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SampleIntervalMs}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="结果上限" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaxResults}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="超时 ms" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ResponseTimeoutMs}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="重试" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding RetryCount}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="间隔 ms" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding IntervalMs}" />
                        </StackPanel>
                    </Grid>

                    <CheckBox IsChecked="{Binding ExcludeNonFinite}" Content="过滤 NaN / Inf 与不合理浮点值" />

                    <TextBlock Text="{Binding RangeHint}" TextWrapping="Wrap" Foreground="#4A4A55" Margin="0,6,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="开始定位" Command="{Binding StartCommand}" FontWeight="SemiBold"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                        <Button Content="暂停/继续" Command="{Binding PauseResumeCommand}" IsEnabled="{Binding IsRunning}" />
                        <Button Content="停止" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="清空" Command="{Binding ClearCommand}" />
                        <Button Content="导出 CSV" Command="{Binding ExportCommand}" />
                    </StackPanel>

                    <TextBlock Text="说明" Style="{StaticResource SectionHeader}" />
                    <TextBlock TextWrapping="Wrap" Foreground="#4A4A55"
                               Text="一次采样、多次解释：范围内寄存器只读一遍，再在内存里按“类型 × 字节序 × 缩放”逐一解释，避免反复占用现场总线。&#10;候选结果只做排序，不自动确认；请同时核对协议地址、原始寄存器与解释规则。" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="3"
                    Padding="10" Margin="0,0,0,8" Background="White">
                <StackPanel>
                    <ProgressBar Height="14" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
                    <TextBlock Text="{Binding ProgressText}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#1B5E9B" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                <CheckBox IsChecked="{Binding OnlyHighScore}" Content="只显示高分候选（≥）" />
                <TextBox Text="{Binding MinScore}" Width="60" />
                <Button Content="候选详情" Command="{Binding ShowDetailCommand}" />
                <Button Content="加入监视表" Command="{Binding AddToWatchCommand}" />
                <Button Content="生成读取报文" Command="{Binding BuildReadFrameCommand}" />
                <TextBlock Text="地址列为协议地址（0 基）；详情中给出 1 基与 4xxxx 显示值" VerticalAlignment="Center"
                           Foreground="#4A4A55" Margin="10,0,0,0" />
            </StackPanel>

            <DataGrid Grid.Row="2" ItemsSource="{Binding CandidatesView}" SelectedItem="{Binding SelectedCandidate}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="协议地址" Binding="{Binding Address}" Width="80" />
                    <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80" />
                    <DataGridTextColumn Header="字节序" Binding="{Binding Order}" Width="70" />
                    <DataGridTextColumn Header="缩放" Binding="{Binding Scale}" Width="60" />
                    <DataGridTextColumn Header="原始寄存器" Binding="{Binding RawHex}" Width="180" FontFamily="{StaticResource MonoFont}" />
                    <DataGridTextColumn Header="解析值" Binding="{Binding ValueText}" Width="140" />
                    <DataGridTextColumn Header="匹配值" Binding="{Binding MatchedValue}" Width="100" />
                    <DataGridTextColumn Header="分数" Binding="{Binding MatchScore}" Width="60" />
                    <DataGridTextColumn Header="解释规则" Binding="{Binding InterpretationText}" Width="240" />
                    <DataGridTextColumn Header="说明" Binding="{Binding Reason}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
