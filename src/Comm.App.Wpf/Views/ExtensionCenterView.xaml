<UserControl x:Class="Comm.App.Wpf.Views.ExtensionCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <!-- 顶部：状态与操作 -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="3"
                Background="{StaticResource PanelBrush}" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="扩展中心（插件宿主）" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DirectoryText}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="重新扫描" Command="{Binding ReloadCommand}" FontWeight="SemiBold" />
                    <Button Content="启用选中插件" Command="{Binding EnableCommand}" />
                    <Button Content="禁用选中插件" Command="{Binding DisableCommand}" />
                    <Button Content="创建插件目录" Command="{Binding CreatePluginDirectoryCommand}" />
                    <Button Content="打开插件目录" Command="{Binding OpenPluginDirectoryCommand}" />
                    <Button Content="复制诊断信息" Command="{Binding CopyDiagnosticsCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding SecurityNotice}" TextWrapping="Wrap" Foreground="#B26500" Margin="0,6,0,0" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#1B5E9B" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- 中部：插件列表 -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Plugins}" SelectedItem="{Binding SelectedPlugin}" AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="插件 Id" Binding="{Binding Id}" Width="150" />
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="220" />
                <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="70" />
                <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="150" />
                <DataGridTextColumn Header="能力" Binding="{Binding CapabilitiesText}" Width="200" />
                <DataGridTextColumn Header="风险" Binding="{Binding RiskText}" Width="180" />
                <DataGridTextColumn Header="错误/原因" Binding="{Binding Error}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部：选中插件详情 + 已注册扩展点 -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="3"
                    Background="White" Padding="8" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="插件详情" Style="{StaticResource SectionHeader}" />
                    <TextBox Grid.Row="1" Text="{Binding DetailText}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11"
                             VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" />
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="3"
                    Background="White" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="已注册扩展点" Style="{StaticResource SectionHeader}" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Registrations}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="插件" Binding="{Binding PluginId}" Width="130" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="110" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
