<UserControl x:Class="Comm.App.Wpf.Views.ManualSendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <Grid Margin="12" Width="1210" HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- 字段构建 -->
        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="3"
                Padding="12" Margin="0,0,12,0" Background="{StaticResource PanelBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="按字段构建（生成时自动填入校验位）" Style="{StaticResource SectionHeader}" />

                    <TextBlock Text="报文格式" Style="{StaticResource SectionHeader}" />
                    <ComboBox ItemsSource="{Binding TransportOptions}" DisplayMemberPath="Display"
                              SelectedValuePath="Value" SelectedValue="{Binding Transport}"
                              ToolTip="选择 RTU 或 TCP 后，**未连接设备也能生成与校验报文**；发送仍需活动连接" />
                    <TextBlock Text="{Binding SendAvailabilityText}" TextWrapping="Wrap" Foreground="#4A4A55" Margin="0,0,0,6" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="从站/单元" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UnitId}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="功能码" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding FunctionOptions}" DisplayMemberPath="Display"
                                      SelectedValuePath="Value" SelectedValue="{Binding FunctionCode}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="起始地址" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding StartAddress}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="数量" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Quantity}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="写值（06）" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding WriteValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="线圈状态（05）" Style="{StaticResource FieldLabel}" />
                            <CheckBox IsChecked="{Binding CoilOn}" Content="ON" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="TCP 事务标识（仅 Modbus TCP 使用）" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding TcpTransactionId}" />
                    <CheckBox IsChecked="{Binding TransactionIdAutoIncrement}"
                              Content="每次生成后事务标识自动递增" />

                    <Button Content="生成报文并自动补校验" Command="{Binding BuildFromFieldsCommand}" HorizontalAlignment="Left" />

                    <TextBlock Text="报文模板" Style="{StaticResource SectionHeader}" />
                    <ComboBox ItemsSource="{Binding Templates}" DisplayMemberPath="DisplayText"
                              SelectedItem="{Binding SelectedTemplate}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="应用模板" Command="{Binding ApplyTemplateCommand}" />
                        <Button Content="删除模板" Command="{Binding DeleteTemplateCommand}" />
                    </StackPanel>
                    <TextBox Text="{Binding TemplateName}" ToolTip="模板名称（可空）" />
                    <Button Content="收藏当前报文为模板" Command="{Binding SaveTemplateCommand}" HorizontalAlignment="Left" />

                    <TextBlock Text="{Binding ModeHint}" TextWrapping="Wrap" Foreground="#4A4A55" Margin="0,10,0,0" />
                    <TextBlock Text="说明：写功能码（05/06/0F/10）发送前必须二次确认；05/0F 的多点写入与自定义功能码可直接在右侧用原始十六进制编辑。"
                               TextWrapping="Wrap" Foreground="#4A4A55" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 报文编辑 -->
        <Grid Grid.Column="1" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="160" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="报文输入（十六进制，可含空格/0x/大小写混用）" Style="{StaticResource SectionHeader}" />
            <TextBox Grid.Row="1" Style="{StaticResource HexBox}" Text="{Binding HexText, UpdateSourceTrigger=PropertyChanged}" />

            <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                <Button Content="自动填入校验位" Command="{Binding AppendChecksumCommand}" />
                <Button Content="校验报文" Command="{Binding ValidateCommand}" />
                <CheckBox IsChecked="{Binding CrcLocked}" Content="锁定（手工编辑校验位）" />
                <CheckBox IsChecked="{Binding AllowBadChecksum}" Content="允许发送校验错误帧" />
            </WrapPanel>

            <StackPanel Grid.Row="3">
                <TextBlock Text="{Binding ValidationText}" Foreground="#1B5E9B" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{Binding MbapText}" TextWrapping="Wrap" Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}"
                           Foreground="#4A4A55" />
            </StackPanel>

            <WrapPanel Grid.Row="4" Margin="0,10,0,0" VerticalAlignment="Top">
                <Button Content="发送一次" Command="{Binding SendOnceCommand}" FontWeight="SemiBold" />
                <Button Content="循环发送 / 停止" Command="{Binding ToggleLoopCommand}" />
                <TextBlock Text="间隔 ms" VerticalAlignment="Center" Margin="8,0,4,0" />
                <TextBox Text="{Binding LoopIntervalMs}" Width="60" />
                <CheckBox IsChecked="{Binding ExpectResponse}" Content="等待响应" />
                <TextBlock Text="超时覆盖 ms（空=用会话默认）" VerticalAlignment="Center" Margin="8,0,4,0" />
                <TextBox Text="{Binding TimeoutOverrideMs}" Width="70" />
            </WrapPanel>
        </Grid>

        <!-- 响应与历史 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="响应与结果" Style="{StaticResource SectionHeader}" />
            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="3"
                    Background="White" Padding="6" Margin="0,0,0,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding ResponseText}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="2" Text="历史（双击可载入报文）" Style="{StaticResource SectionHeader}" />
            <Grid Grid.Row="3">
                <ListBox ItemsSource="{Binding History}" FontFamily="{StaticResource MonoFont}" FontSize="12">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding DataContext.UseHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                      CommandParameter="{Binding}" />
                    </ListBox.InputBindings>
                </ListBox>
                <Button Content="清空历史" Command="{Binding ClearHistoryCommand}" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Margin="0,0,6,6" />
            </Grid>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
