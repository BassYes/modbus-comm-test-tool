<UserControl x:Class="Comm.App.Wpf.Views.DataScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="3"
                Padding="12" Margin="0,0,12,0" Background="{StaticResource PanelBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="扫描参数" Style="{StaticResource SectionHeader}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="从站地址" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UnitId}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="数据区" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding AreaOptions}" DisplayMemberPath="Display"
                                      SelectedValuePath="Value" SelectedValue="{Binding Area}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="起始" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding StartAddress}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="结束" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding EndAddress}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="每次点数 0=自动" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding BatchSize}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="数据类型与字节序" Style="{StaticResource SectionHeader}" />
                    <ComboBox ItemsSource="{Binding TypeOptions}" DisplayMemberPath="Display"
                              SelectedValuePath="Value" SelectedValue="{Binding DataType}" />
                    <ComboBox ItemsSource="{Binding OrderOptions}" DisplayMemberPath="Display"
                              SelectedValuePath="Value" SelectedValue="{Binding ByteOrder}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="缩放系数" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Scale}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="偏移" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Offset}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="地址显示风格" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding StyleOptions}" DisplayMemberPath="Display"
                              SelectedValuePath="Value" SelectedValue="{Binding AddressStyle}" />

                    <TextBlock Text="读取参数" Style="{StaticResource SectionHeader}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="超时 ms" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ResponseTimeoutMs}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="重试" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding RetryCount}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="间隔 ms" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding IntervalMs}" />
                        </StackPanel>
                    </Grid>

                    <CheckBox IsChecked="{Binding RefineInvalidBlocks}" Content="非法地址时二分细化有效区间" />

                    <TextBlock Text="{Binding RangeHint}" TextWrapping="Wrap" Foreground="#4A4A55" Margin="0,6,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="开始扫描" Command="{Binding StartCommand}" FontWeight="SemiBold"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                        <Button Content="暂停/继续" Command="{Binding PauseResumeCommand}" IsEnabled="{Binding IsRunning}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="停止" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" />
                        <Button Content="清空" Command="{Binding ClearCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="导出 CSV" Command="{Binding ExportCommand}" />
                        <Button Content="点位详情" Command="{Binding DecodeSelectedCommand}" />
                        <Button Content="加入监视表" Command="{Binding AddToWatchCommand}" />
                    </StackPanel>

                    <TextBlock Text="扫描方案" Style="{StaticResource SectionHeader}" />
                    <ComboBox ItemsSource="{Binding Plans}" DisplayMemberPath="DisplayText" SelectedItem="{Binding SelectedPlan}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="载入方案" Command="{Binding LoadPlanCommand}" />
                        <Button Content="删除方案" Command="{Binding DeletePlanCommand}" />
                    </StackPanel>
                    <TextBox Text="{Binding PlanName}" ToolTip="方案名称（可空）" />
                    <Button Content="保存当前参数为方案" Command="{Binding SavePlanCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="3"
                    Padding="10" Margin="0,0,0,8" Background="White">
                <StackPanel>
                    <ProgressBar Height="14" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
                    <TextBlock Text="{Binding ProgressText}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#1B5E9B" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                <CheckBox IsChecked="{Binding OnlyIssues}" Content="只显示异常点位" />
            </StackPanel>

            <DataGrid Grid.Row="2" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="数据区" Binding="{Binding Area}" Width="110" />
                    <DataGridTextColumn Header="协议地址" Binding="{Binding Address}" Width="80" />
                    <DataGridTextColumn Header="原始值" Binding="{Binding RawHex}" Width="90" />
                    <DataGridTextColumn Header="解析值" Binding="{Binding ValueText}" Width="180" />
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80" />
                    <DataGridTextColumn Header="异常码" Binding="{Binding ExceptionCode, StringFormat=X2}" Width="70" />
                    <DataGridTextColumn Header="耗时 ms" Binding="{Binding ElapsedMs, StringFormat=F1}" Width="75" />
                    <DataGridTextColumn Header="说明" Binding="{Binding Note}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
