<UserControl x:Class="Comm.App.Wpf.Views.DeviceScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 参数 -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" BorderBrush="{StaticResource BorderBrushLight}"
                BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,12,0" Background="{StaticResource PanelBrush}">
            <StackPanel>
                <TextBlock Text="扫描参数" Style="{StaticResource SectionHeader}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="起始地址" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding StartAddress}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="结束地址" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding EndAddress}" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="超时 ms" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ResponseTimeoutMs}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="重试" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding RetryCount}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="间隔 ms" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding IntervalMs}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="探测方式" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding ModeOptions}" DisplayMemberPath="Display"
                          SelectedValuePath="Value" SelectedValue="{Binding ProbeMode}" />

                <!-- R-17：手动探测（只有只读功能码可选） -->
                <StackPanel IsEnabled="{Binding IsManualMode}">
                    <ComboBox ItemsSource="{Binding ProbeFunctionOptions}" DisplayMemberPath="Display"
                              SelectedValuePath="Value" SelectedValue="{Binding ManualProbeFunction}"
                              ToolTip="扫描任务只能使用只读功能码" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="探测起始地址" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ManualProbeAddress}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="探测数量" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ManualProbeQuantity}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <CheckBox IsChecked="{Binding ConfirmFound}" Content="发现后二次确认" />
                <CheckBox IsChecked="{Binding TryDeviceIdentification}">
                    <TextBlock TextWrapping="Wrap" Text="尝试读取设备标识（43/14）" ToolTip="可得到厂商与型号" />
                </CheckBox>

                <TextBlock Text="{Binding EstimatedText}" TextWrapping="Wrap" Foreground="#4A4A55" Margin="0,6,0,10" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="开始扫描" Command="{Binding StartCommand}" FontWeight="SemiBold"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                    <Button Content="暂停/继续" Command="{Binding PauseResumeCommand}" IsEnabled="{Binding IsRunning}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="停止" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" />
                    <Button Content="清空" Command="{Binding ClearCommand}" />
                    <Button Content="导出 CSV" Command="{Binding ExportCommand}" />
                </StackPanel>

                <TextBlock Text="结果操作" Style="{StaticResource SectionHeader}" />
                <Button Content="将选中地址设为 Unit ID" Command="{Binding UseAsTargetCommand}" HorizontalAlignment="Left" />
                <Button Content="把选中地址加入监视表" Command="{Binding AddToWatchCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />

                <TextBlock Text="扫描方案" Style="{StaticResource SectionHeader}" />
                <ComboBox ItemsSource="{Binding Plans}" DisplayMemberPath="DisplayText" SelectedItem="{Binding SelectedPlan}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="载入方案" Command="{Binding LoadPlanCommand}" />
                    <Button Content="删除方案" Command="{Binding DeletePlanCommand}" />
                </StackPanel>
                <TextBox Text="{Binding PlanName}" ToolTip="方案名称（可空，使用地址范围作为名称）" />
                <Button Content="保存当前参数为方案" Command="{Binding SavePlanCommand}" HorizontalAlignment="Left" />

                <TextBlock Text="说明" Style="{StaticResource SectionHeader}" />
                <TextBlock TextWrapping="Wrap" Foreground="#4A4A55"
                           Text="自动模板：探测顺序 03 → 04 → 01 → 02，起始地址 0、数量 1。&#10;手动探测：只允许只读功能码 01/02/03/04，起始地址与数量由用户指定。&#10;合法异常响应也判定设备在线（地址未实现但设备存在）。&#10;扫描绝不使用写功能码，也绝不使用广播地址 0。" />
            </StackPanel>
        </Border>

        <!-- 进度 -->
        <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1"
                CornerRadius="3" Padding="10" Margin="0,0,0,8" Background="White">
            <StackPanel>
                <ProgressBar Height="14" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
                <TextBlock Text="{Binding ProgressText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#1B5E9B" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{Binding RecentEventText}" Foreground="#1E7B34" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
            <CheckBox IsChecked="{Binding OnlyOnline}" Content="只显示在线/疑似" />
        </StackPanel>

        <!-- 结果 -->
        <DataGrid Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="从站地址" Binding="{Binding Address}" Width="80" />
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="70" />
                <DataGridTextColumn Header="首次发现" Binding="{Binding FirstSeen, StringFormat=HH:mm:ss.fff}" Width="100" />
                <DataGridTextColumn Header="最近响应" Binding="{Binding LastSeen, StringFormat=HH:mm:ss.fff}" Width="100" />
                <DataGridTextColumn Header="耗时 ms" Binding="{Binding ElapsedMs, StringFormat=F1}" Width="70" />
                <DataGridTextColumn Header="探测功能码" Binding="{Binding ProbeFunctionText}" Width="170" />
                <DataGridTextColumn Header="异常码" Binding="{Binding ExceptionCode, StringFormat=X2}" Width="60" />
                <DataGridTextColumn Header="设备标识" Binding="{Binding DeviceIdentification}" Width="200" />
                <DataGridTextColumn Header="说明" Binding="{Binding Note}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
