<UserControl x:Class="Comm.App.Wpf.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="3"
                Padding="8" Background="{StaticResource PanelBrush}">
            <WrapPanel>
                <CheckBox IsChecked="{Binding Monitor.ParseEnabled}" Content="报文解析" />
                <CheckBox IsChecked="{Binding Monitor.DisplayPaused}" Content="暂停显示（采集与记录继续）" />
                <CheckBox IsChecked="{Binding Monitor.AutoScroll}" Content="自动滚动" />
                <CheckBox IsChecked="{Binding Monitor.ColorizeDirections}" Content="TX/RX 着色"
                          ToolTip="关闭后仍保留 TX/RX 文字与箭头标记，不单靠颜色区分" />
                <Button Content="清空显示" Command="{Binding ClearCommand}" />
                <Button Content="保存 TXT" Command="{Binding SaveTextCommand}" />
                <Button Content="保存 CSV" Command="{Binding SaveCsvCommand}" />
                <Button Content="开始记录" Command="{Binding StartRecordingCommand}" />
                <Button Content="停止记录" Command="{Binding StopRecordingCommand}" />
                <Button Content="复制选中报文" Command="{Binding CopySelectedHexCommand}" />
                <Button Content="报文详情" Command="{Binding SendSelectedToManualCommand}" />
            </WrapPanel>
        </Border>

        <!-- 过滤 -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="3"
                Padding="8" Margin="0,8,0,8" Background="White">
            <WrapPanel>
                <TextBlock Text="方向" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox ItemsSource="{Binding DirectionOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                          SelectedValue="{Binding Monitor.DirectionFilter}" Width="130" />
                <TextBlock Text="从站" VerticalAlignment="Center" Margin="8,0,4,0" />
                <TextBox Text="{Binding Monitor.UnitFilter}" Width="60" />
                <TextBlock Text="功能码(十六进制)" VerticalAlignment="Center" Margin="8,0,4,0" />
                <TextBox Text="{Binding Monitor.FunctionFilter}" Width="60" />
                <TextBlock Text="报文/摘要包含" VerticalAlignment="Center" Margin="8,0,4,0" />
                <TextBox Text="{Binding Monitor.TextFilter}" Width="160" />
                <Button Content="应用过滤" Command="{Binding ApplyFiltersCommand}" />
            </WrapPanel>
        </Border>

        <!-- 报文列表 -->
        <DataGrid x:Name="FramesGrid" Grid.Row="2" ItemsSource="{Binding Monitor.Rows}"
                  SelectedItem="{Binding SelectedRecord}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{Binding IsError, Converter={StaticResource StatusToBrush}}" />
                    <Setter Property="Foreground">
                        <Setter.Value>
                            <MultiBinding Converter="{StaticResource DirectionBrushToggle}">
                                <Binding Path="Direction" />
                                <Binding Path="DataContext.Monitor.ColorizeDirections"
                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号" Binding="{Binding Seq}" Width="70" />
                <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="100" />
                <DataGridTextColumn Header="方向" Binding="{Binding DirectionText}" Width="55" FontWeight="Bold" />
                <DataGridTextColumn Header="从站" Binding="{Binding UnitIdText}" Width="55" />
                <DataGridTextColumn Header="功能码" Binding="{Binding FunctionText}" Width="65" />
                <DataGridTextColumn Header="报文" Binding="{Binding Hex}" Width="360" FontFamily="{StaticResource MonoFont}" />
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80" />
                <DataGridTextColumn Header="标记" Binding="{Binding MarkerText}" Width="100" />
                <DataGridTextColumn Header="耗时ms" Binding="{Binding ElapsedText}" Width="70" />
                <DataGridTextColumn Header="解析摘要" Binding="{Binding Summary}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 详情 -->
        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="3"
                Background="White" Padding="8" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="选中报文详情" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding DetailText}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
                </ScrollViewer>
                <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="#4A4A55" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
