<Application x:Class="Comm.App.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Comm.App.Wpf.ViewModels"
             xmlns:views="clr-namespace:Comm.App.Wpf.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                页面模板放在应用级资源里（M3b）：主窗口与拆分出来的会话窗口都要用同一套模板。
                习惯上"页面 ← ViewModel"的映射集中在这里，新增页面时同步维护。
            -->
            <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
                <views:ConnectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DeviceScanViewModel}">
                <views:DeviceScanView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UnitIdScanViewModel}">
                <views:UnitIdScanView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DataScanViewModel}">
                <views:DataScanView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RegisterLocatorViewModel}">
                <views:RegisterLocatorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WatchTableViewModel}">
                <views:WatchTableView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ManualSendViewModel}">
                <views:ManualSendView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
                <views:MonitorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NetworkToolsViewModel}">
                <views:NetworkToolsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LanScanViewModel}">
                <views:LanScanView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ExtensionCenterViewModel}">
                <views:ExtensionCenterView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
